{
  "name": "reim-open",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Agent-native, source-aware real estate investment analysis skill with offline calculator and paginated HTML reports",
  "bin": {
    "reim": "./bin/reim.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:skill": "node scripts/package-skill.mjs",
    "demo": "node bin/reim.mjs report examples/damac-heights.json out/damac-report.html",
    "demo:offplan": "node skills/reim/scripts/offplan.mjs report skills/reim/assets/examples/yas-living-2br-maid-offplan.json out/yas-living-report.html"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
